# =============================================================================
# Archivo de ejemplo de variables de entorno - Cartera360
# Copiar este archivo a .env y completar los valores reales.
# Nunca subir este archivo con llaves reales a GitHub.
# =============================================================================

# Llave de API del agente de IA (analista virtual de cartera)
IA_API_KEY=tu_llave_de_api_aqui

# URL del endpoint del agente de IA (opcional, según el proveedor)
IA_API_URL=https://api.ejemplo.com/agente-cartera

# Configuración de Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Clave secreta para sesiones de Flask
SECRET_KEY=tu_clave_secreta_aqui

# Credenciales de acceso (cambiar en producción)
APP_USUARIO=tu_usuario
APP_CLAVE=tu_clave
